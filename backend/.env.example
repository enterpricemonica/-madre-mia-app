# Copy this file to .env and fill in REAL values. NEVER commit the real .env.
# Database connection URL: postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost/madre_mia
# Staff login secret (JWT signing) — generate a long random string
SECRET_KEY=CHANGE_ME_to_a_long_random_string
# JWT signing algorithm
ALGORITHM=HS256
# Admin user created automatically on startup (set your own values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ── Bold (pago integrado / datáfono) ──
# Local: apunta al mock (puerto 9000). Sandbox/prod: la URL real + la llave real de Bold.
BOLD_API_URL=http://localhost:9000
BOLD_API_KEY=mock-key
BOLD_TERMINAL_MODEL=BOLD_S1
BOLD_TERMINAL_SERIAL=MOCK-0001

# ── Wompi (pago online del cliente desde su celular) ──
# Sandbox: https://sandbox.wompi.co/v1  ·  Producción: https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_TU_LLAVE_PUBLICA
WOMPI_PRIVATE_KEY=prv_test_TU_LLAVE_PRIVADA
WOMPI_INTEGRITY_SECRET=TU_SECRETO_DE_INTEGRIDAD
WOMPI_EVENTS_SECRET=TU_SECRETO_DE_EVENTOS
